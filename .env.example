# İlkim Koleksiyon — statik önizleme (yalnızca yerel derleme için)
# GitHub Actions bu değerleri actions/configure-pages çıktısından otomatik verir.
# Bu sürümde gizli anahtar kullanılmaz; bu dosyaya token veya parola eklemeyin.

# Sitenin kökü (alt yol olmadan)
SITE_URL=http://localhost:5510

# Alt yol. Proje sitesi: /depo-adi · Kullanıcı sitesi (kullanici.github.io): boş bırakın
# Git Bash'te komutun başına MSYS_NO_PATHCONV=1 ekleyin; aksi halde Windows yoluna çevrilir.
BASE_PATH=
